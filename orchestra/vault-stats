#!/usr/bin/env bash
# Vault statistics: note counts by folder, recent activity
# Usage: vault-stats
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VAULT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

role_dir() {
    local role="$1" default="$2" map="$VAULT_DIR/Meta/vault-map.md" v=""
    [[ -f "$map" ]] && v="$(awk -F': *' -v r="$role" '/^---/{n++; next} n==1 && $1==r {gsub(/\r/,"",$2); print $2; exit}' "$map")"
    echo "${v:-$default}"
}
mtime() { stat -c "%y" "$1" 2>/dev/null | cut -c1-16 || stat -f "%Sm" -t "%Y-%m-%d %H:%M" "$1" 2>/dev/null || echo "?"; }

echo "=== Vault Statistics ==="
echo ""

for pair in inbox:Inbox daily:Daily threads:Threads commitments:Commitments people:People archive:Archive meta:Meta; do
    dir="$(role_dir "${pair%%:*}" "${pair##*:}")"
    if [[ -d "$VAULT_DIR/$dir" ]]; then
        count=$(find "$VAULT_DIR/$dir" -name "*.md" -not -path "*/.*" 2>/dev/null | wc -l | tr -d ' ')
        printf "%-20s %s notes\n" "$dir/" "$count"
    fi
done

echo ""
echo "=== Recent Activity (last 24h) ==="
find "$VAULT_DIR" -name "*.md" -not -path "*/.*" -mmin -1440 2>/dev/null | while read -r f; do
    rel="${f#$VAULT_DIR/}"
    echo "  $(mtime "$f")  $rel"
done | sort -r | head -20

echo ""
echo "=== Total ==="
total=$(find "$VAULT_DIR" -name "*.md" -not -path "*/.*" 2>/dev/null | wc -l | tr -d ' ')
echo "$total notes in vault"
